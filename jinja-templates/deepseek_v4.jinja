{%- set bos_token = "<｜begin▁of▁sentence｜>" -%}
{%- set eos_token = "<｜end▁of▁sentence｜>" -%}
{#- The checkpoint's own markers (encoding_dsv4.py:19-20). These were BOTH the
    empty string since the original port, so the template emitted neither
    marker: the generation prompt never opened `<think>` when thinking was
    requested, never closed it with `</think>` when it was not, and historical
    reasoning_content was replayed unwrapped. That also broke the scheduler's
    `inside_thinking` tracking, which gates speculation — with no `</think>`
    ever emitted it cannot tell reasoning from answer. -#}
{%- set thinking_start_token = "<think>" -%}
{%- set thinking_end_token = "</think>" -%}
{%- set user_token = "<｜User｜>" -%}
{%- set assistant_token = "<｜Assistant｜>" -%}
{%- set dsml_token = "｜DSML｜" -%}

{%- if not messages %}
    {{- raise_exception('No messages provided.') }}
{%- endif %}

{%- macro render_content(content) %}
    {%- if content is string %}
        {{- content }}
    {%- elif content is iterable and content is not mapping %}
        {%- for item in content %}
            {%- if 'text' in item %}
                {{- item.text }}
            {%- elif 'image' in item or 'image_url' in item %}
                {{- '[Image]' }}
            {%- else %}
                {{- raise_exception('Unexpected item type in content.') }}
            {%- endif %}
        {%- endfor %}
    {%- elif content is none or content is undefined %}
        {{- '' }}
    {%- else %}
        {{- raise_exception('Unexpected content type.') }}
    {%- endif %}
{%- endmacro %}

{#- Assistant tool calls in the checkpoint's native DSML syntax
    (encoding_dsv4.py: tool_calls_template / tool_call_template /
    encode_arguments_to_dsml). `｜` is U+FF5C FULLWIDTH VERTICAL LINE.
    String args go raw with string="true"; every other type is JSON
    with string="false" — the DsmlV4Parser decodes the mirror image. -#}
{%- macro render_tool_calls(tool_calls) %}
    {{- '\n\n<' + dsml_token + 'tool_calls>\n' }}
    {%- for tool_call in tool_calls %}
        {%- if tool_call.function is defined %}
            {%- set tool_call = tool_call.function %}
        {%- endif %}
        {%- if not loop.first %}
            {{- '\n' }}
        {%- endif %}
        {{- '<' + dsml_token + 'invoke name="' + tool_call.name + '">\n' }}
        {%- if tool_call.arguments is defined %}
            {%- if tool_call.arguments is mapping %}
                {%- for args_name, args_value in tool_call.arguments|items %}
                    {%- if not loop.first %}
                        {{- '\n' }}
                    {%- endif %}
                    {%- if args_value is string %}
                        {{- '<' + dsml_token + 'parameter name="' + args_name + '" string="true">' + args_value }}
                    {%- else %}
                        {{- '<' + dsml_token + 'parameter name="' + args_name + '" string="false">' + (args_value | tojson) }}
                    {%- endif %}
                    {{- '</' + dsml_token + 'parameter>' }}
                {%- endfor %}
            {%- elif tool_call.arguments is string %}
                {{- tool_call.arguments }}
            {%- endif %}
        {%- endif %}
        {{- '\n</' + dsml_token + 'invoke>' }}
    {%- endfor %}
    {{- '\n</' + dsml_token + 'tool_calls>' }}
{%- endmacro %}

{%- set first_message = true -%}
{%- for message in messages %}
    {%- set content = render_content(message.content) -%}
    {%- if message.role == "system" %}
        {%- if first_message %}
            {{- bos_token }}
        {%- endif %}
        {{- content }}
    {%- elif message.role == "user" %}
        {%- if first_message %}
            {{- bos_token }}
        {%- endif %}
        {{- user_token + content + assistant_token }}
    {%- elif message.role == "assistant" %}
        {%- set reasoning_content = '' -%}
        {%- if message.reasoning_content is string %}
            {%- set reasoning_content = message.reasoning_content -%}
        {%- endif %}
        {%- set reasoning_content = reasoning_content | trim -%}
        {%- if reasoning_content %}
            {{- thinking_start_token + reasoning_content + thinking_end_token }}
        {%- endif %}
        {{- content }}
        {%- if message.tool_calls and message.tool_calls is iterable and message.tool_calls is not mapping %}
            {{- render_tool_calls(message.tool_calls) }}
        {%- endif %}
        {{- eos_token }}
    {%- elif message.role == "tool" %}
        {#- The checkpoint has no `tool` role: merge_tool_messages() folds
            tool results into a USER turn as <tool_result> blocks joined by
            "\n\n". So open <｜User｜> once per RUN of tool messages and
            close with <｜Assistant｜> once the run ends. -#}
        {%- if not loop.previtem or loop.previtem.role != "tool" %}
            {%- if first_message %}
                {{- bos_token }}
            {%- endif %}
            {{- user_token }}
        {%- else %}
            {{- '\n\n' }}
        {%- endif %}
        {{- '<tool_result>' + content + '</tool_result>' }}
        {%- if loop.last or loop.nextitem.role != "tool" %}
            {{- assistant_token }}
        {%- endif %}
    {%- else %}
        {{- raise_exception('Unexpected message role.') }}
    {%- endif %}
    {%- set first_message = false -%}
{%- endfor %}

{%- if add_generation_prompt %}
    {%- if enable_thinking is defined and enable_thinking == false %}
        {{- thinking_end_token }}
    {%- else %}
        {{- thinking_start_token }}
    {%- endif %}
{%- endif %}
