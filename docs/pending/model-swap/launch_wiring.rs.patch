// ── 3. tui/lib_state.rs — replaces the toast-returning `launch` ─────────────

    /// Start the selected recipe, replacing whatever is running.
    ///
    /// Returns when the loader THREAD is spawned, not when the swap succeeds —
    /// a load is minutes of shard reading and the dashboard must stay
    /// interactive through it. The outcome arrives on `launch_result`, which
    /// `poll_launch` drains: a message is a failure to show, and a silent
    /// disconnect is success. That contract is already pinned by
    /// `lib_state_tests.rs`.
    ///
    /// Off the UI thread for a second reason as well: `model_swap::swap` is
    /// blocking and the dashboard is a plain `std::thread` with no runtime in
    /// scope. `swap` enters the host's captured runtime handle itself, so
    /// neither this call site nor the one inside the server has to know which
    /// of them is already on a runtime.
    ///
    /// Single-flight is NOT enforced here. It is enforced inside `swap`, under
    /// `ModelHost::swap_guard`, because this is not the only caller and a guard
    /// at one call site is a guard the next caller forgets. Pressing `s` twice
    /// spawns two threads; the second blocks on the guard, re-reads what is
    /// loaded, and returns without loading anything if the winner already
    /// loaded exactly what it wanted.
    pub fn launch(
        &mut self,
        host: &std::sync::Arc<crate::main_modules::model_host::ModelHost>,
    ) -> Result<(), String> {
        let recipe = self.config_recipe().ok_or("no recipe selected")?;
        // Built and VALIDATED on this thread, before anything is spawned. A
        // recipe that cannot produce a legal command line is a form error the
        // user can fix, and it must read as one — not as a load that starts,
        // tears the running model down, and then discovers the same thing.
        let args = recipe
            .serve_args_edited(&self.overrides, &self.removed)
            .map_err(|e| problem_line(&format!("{e:#}")))?;

        let host = host.clone();
        let (tx, rx) = std::sync::mpsc::channel::<String>();
        std::thread::Builder::new()
            .name("atlas-swap".into())
            .spawn(move || {
                if let Err(e) = crate::main_modules::model_swap::swap(&host, args) {
                    // Send, do not log-and-forget: the dashboard owns this
                    // terminal, so a `tracing::error` here is a line in the log
                    // pane the user may never scroll to, while the load pill
                    // sits on LOADING forever. Dropping the sender on success
                    // is what `poll_launch` reads as "it worked".
                    let _ = tx.send(format!("{e:#}"));
                }
            })
            .map_err(|e| format!("could not start the loader thread: {e}"))?;
        self.launch_result = Some(rx);
        Ok(())
    }

