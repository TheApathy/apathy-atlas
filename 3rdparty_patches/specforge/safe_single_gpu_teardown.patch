+    # ATLAS_SAFE_SINGLE_GPU_TEARDOWN: retained in paid-run bundle preflight.
+    """Destroy each non-default process group once, then the world group.
+
+    A one-rank mesh can return the same process-group object for multiple mesh
+    dimensions. Destroying every module global unconditionally therefore tries
+    to destroy an alias twice and turns a successfully saved training run into
+    a failing torchrun job. Keep teardown idempotent and leave the default
+    group until last.
+    """
+    global _TP_GROUP, _DP_GROUP, _SP_ULYSSES_GROUP, _SP_RING_GROUP
+    global _DRAFT_DP_GROUP, _DRAFT_SP_GROUP
+
+    if not dist.is_available() or not dist.is_initialized():
+        return
+
+    groups = (
+        _TP_GROUP,
+        _DP_GROUP,
+        _SP_ULYSSES_GROUP,
+        _SP_RING_GROUP,
+        _DRAFT_DP_GROUP,
+        _DRAFT_SP_GROUP,
+    )
+    seen = set()
+    for group in groups:
+        if group is None or group is dist.group.WORLD or id(group) in seen:
+            continue
+        seen.add(id(group))
+        try:
+            dist.destroy_process_group(group)
+        except ValueError:
+            # DeviceMesh may already have destroyed an aliased child group.
+            pass
+
     dist.destroy_process_group()
