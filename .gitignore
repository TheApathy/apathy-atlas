# Build artifacts
target/
**/target/
# Out-of-tree cargo target dirs used for parallel/experiment builds
# (target-final, target-fu, target-i84, target-phc, target-rc, ...).
target-*/
*.o
*.ptx
*.bak
# Local docker build input: release binary copied in before `docker build`.
# Regenerated from `target/release/spark`; never tracked.
docker/gb10/spark-fastbin

# tool-eval-bench run reports — local benchmark output, not source
/runs/
# Vendored crate's `Cargo.toml.orig` from upstream merge — regenerated
# on every `cargo vendor`, shouldn't be tracked.
**/Cargo.toml.orig

# mdBook output (book/src is tracked; book/output is generated)
/book/output/
/book/book/

# Site build artifacts (site/src + site/static are tracked; everything
# below is regenerated by `bun install` + `bun x --bun vite build` and
# must not be committed).
/site/node_modules/
/site/build/
/site/.svelte-kit/
/site/.vite/

# Editor / agent scratch
.claude/
.gemini/
.agent*/
.codex/
.vscode/
.idea/

# Python caches
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Compiled binaries accidentally landing at repo root
/spark-fastbin
/a.out

# Profiling artifacts
*.nsys-rep
*.ncu-rep
*.qdrep
*.sqlite
perf.data*
# Core dumps (PID-suffixed, e.g. core.12345) — NOT source files like
# vendor/cudarc/src/driver/safe/core.rs, which the bare `core.*` glob swallowed.
core.[0-9]*

# ---------------------------------------------------------------------------
# CREDENTIALS. Nothing that authenticates anything may ever be tracked here.
#
# This repo is PUBLIC and AGPL-3.0. A token committed here is a token leaked to
# the world, and git history keeps it even after a follow-up "remove secret"
# commit -- the only real remedy is rotation. So the rule is prevention, not
# cleanup: if a file's job is to hold a credential, it is ignored by pattern
# BEFORE anyone can `git add` it.
#
# Serving these models needs a Hugging Face token (the Laguna and Qwen/AEON
# checkpoints are gated). Keep it in the HF CLI's own store or an untracked
# .env, and read it as $HF_TOKEN -- never inline it in a serve script.
# ---------------------------------------------------------------------------
.env
.env.*
*.env
!example.env
!*.env.example
.envrc
.direnv/

# Hugging Face / model-hub tokens
.huggingface/
hf_token*
.hf_token
huggingface_token*

# Generic secret-bearing filenames
secrets.*
*.secret
*secrets.y*ml
credentials
credentials.*
.netrc
.npmrc
.pypirc

# Keys and certificates (no .pem/.key/.crt source files exist in this tree;
# verified before adding these globs so nothing tracked becomes ignored)
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
*.gpg
*.asc

# Cloud / cluster credential stores
.aws/
.azure/
.gcloud/
gcloud-*.json
*service-account*.json
kubeconfig
*.kubeconfig

# ---------------------------------------------------------------------------
# HOST-IDENTIFYING ARTIFACTS. Serve logs, profiles and run JSON embed absolute
# paths ($HOME, model snapshot dirs), hostnames and device topology. They are
# regenerated per run and per box, they are useless to anyone else, and they
# are the most likely way for machine details to reach a public repo. Keep the
# harness SCRIPTS, drop everything they emit.
# ---------------------------------------------------------------------------
serve*.log
serve-*.log
*-serve.log
bench/ab/
bench/**/ab/
bench/**/*.out
bench/**/*.contam
nsys-*/
*.nsys-rep

# Local model/weight caches and requantization output (tens of GB).
# A stray downloaded checkpoint is the easiest way to blow up a clone, so the
# glob is broad -- but test_data/ holds small tracked LoRA fixtures the test
# suite needs, so those are negated explicitly rather than the glob narrowed.
w3cache/
models/
checkpoints/
*.safetensors
!test_data/**/*.safetensors
*.gguf

# Root-level ad-hoc logs (tracked test result logs under tests/ are intentional)
/*.log

# Bench result artifacts (regenerated per run)
/bench-*-results*.json
/bench_*_results*.json
/bench-*-results*.log
/conc-bench-results/
/bench-results/
/bench-4configs/
/bench-4configs-mtp/
/bench-5configs-final/
/bench_concurrency_results*.json
# JSON results inside bench/ (scripts stay, snapshots don't)
bench/*.json

# Test run history snapshots — none are committed; results are
# regenerated per-host and contain machine-specific paths/timestamps.
tests/all_models_results/
tests/all_models_results.*/
tests/all_models_results_pass*/

# Nested scratch / experiment projects
/tmp/
/tools/

# OS
.DS_Store
Thumbs.db
target-verify/
bench/longcode/results/

