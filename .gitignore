# unaffected; already-tracked suffixed variants stay tracked).
docker/gb10/Dockerfile.*

# bench harness OUTPUT (data/logs, regenerated per run — keep scripts, drop artifacts)
bench/**/runs/
bench/**/reports/
bench/**/logs/
bench/**/*.jsonl
bench/**/*.csv
bench/**/*.pid
bench/fp8_dgx2_drift/harness/oc

